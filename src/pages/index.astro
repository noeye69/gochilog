---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
import Pagination from "@/components/Pagination.astro";

const { posts: postsConfig } = config;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.draft);
const page = {
  url: {
    current: "/",
    prev: undefined,
    next: "/posts/2/",
  },
  currentPage: 1,
  lastPage: Math.ceil(recentPosts.length / postsConfig.perIndex),
};
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    class="app-layout"
  >
    <section id="recent-posts" class="pt-8 pb-6">
      <ul>
        {recentPosts.slice(0, postsConfig.perIndex).map(data => (
          <Card variant="h3" {...data} />
        ))}
      </ul>
      <Pagination {page} />
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    sessionStorage.setItem("backUrl", baseRoot);
  });
</script>