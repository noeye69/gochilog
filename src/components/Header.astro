---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? config.site.lang;
---

<header class="app-layout">
  <div class="border-border bg-background flex items-center justify-between border-b py-4 sm:py-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
    >
      {site.title}
    </a>

    <nav>
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class="text-sm hover:text-accent"
      >
        About
      </a>
    </nav>
  </div>
</header>